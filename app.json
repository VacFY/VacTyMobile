{
  "expo": {
    "name": "VacTy",
    "slug": "vacty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vacty.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#390f07",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vacty.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-notify-kit",
        {
          "android": {
            "foregroundService": {
              "types": [
                "specialUse"
              ],
              "specialUseSubtype": "cold-chain-temperature-monitoring"
            },
            "icons": [
              {
                "name": "ic_notification",
                "path": "./assets/notification-icon.png",
                "type": "small"
              }
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#390f07",
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "vacty",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "44c42d2e-b3c0-4356-bd0d-d6468612497c"
      }
    },
    "description": "Monitoreo de la cadena de frío de vacunas para puestos de salud rurales."
  }
}